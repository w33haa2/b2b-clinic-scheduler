# Production environment for compose.prod.yaml.
# Copy to .env.production (gitignored) and fill in every blank value.

APP_NAME="Clinic App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://clinic.example.com
APP_PORT=80

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=clinic
DB_USERNAME=clinic
DB_PASSWORD=
# Root password for the MySQL container (used only by its init and healthcheck).
DB_ROOT_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Mail is queued, so the "queue" service has to be running or nothing is ever
# sent, and a bad setting here lands in failed_jobs rather than in front of
# anyone.
#
# MAIL_SCHEME accepts only "smtp" (STARTTLS, port 587) and "smtps" (implicit
# TLS, port 465). "tls" and "ssl" throw UnsupportedSchemeException.
#
# For Gmail: host smtp.gmail.com, port 465, scheme smtps, and a 16-character
# App Password -- not the account password. MAIL_FROM_ADDRESS has to match
# MAIL_USERNAME or a verified "Send mail as" alias, or Gmail silently
# rewrites it. See docs/docker.md.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_SCHEME=smtps
# Keep below the queue worker's timeout (60s) so a dropped connection is
# reported rather than killed mid-send.
MAIL_TIMEOUT=15
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

# Baked into the frontend at build time (Vite).
VITE_APP_NAME="${APP_NAME}"

# Server-side rendering container (compose.prod.yaml "ssr" service).
INERTIA_SSR_URL=http://ssr:13714
