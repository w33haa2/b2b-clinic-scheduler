# Production environment for compose.prod.yaml.
# Copy to .env.production (gitignored) and fill in every blank value.

APP_NAME="Clinic App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://clinic.example.com
APP_PORT=80

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=clinic
DB_USERNAME=clinic
DB_PASSWORD=
# Root password for the MySQL container (used only by its init and healthcheck).
DB_ROOT_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

# Baked into the frontend at build time (Vite).
VITE_APP_NAME="${APP_NAME}"

# Server-side rendering container (compose.prod.yaml "ssr" service).
INERTIA_SSR_URL=http://ssr:13714
