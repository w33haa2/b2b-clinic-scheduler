# Environment for a Render deployment with the database in Neon.
#
# This file is a checklist, not something the app reads: Render holds these as
# environment variables on each service (render.yaml declares them, and the
# ones marked `sync: false` are filled in from the dashboard).
#
# See docs/docker.md → "Deploying to Render".

APP_NAME="Clinic App"
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# The service's real URL. Used for absolute links, the sitemap, invitation and
# patient intake links, and Sanctum's stateful domain.
APP_URL=https://clinic-app.onrender.com
ASSET_URL=https://clinic-app.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Neon -------------------------------------------------------------------
# Take these from the Neon dashboard → Connection Details.
# Use the POOLED host (it contains "-pooler"): PHP-FPM holds one connection per
# worker process, and the pooler is what keeps that within Neon's limit.
DB_CONNECTION=pgsql
DB_HOST=ep-xxxx-pooler.us-east-2.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=
# Neon only accepts TLS. "require" encrypts without verifying the CA; use
# "verify-full" with DB_SSLROOTCERT if you ship a CA bundle.
DB_SSLMODE=require

# --- No Redis ---------------------------------------------------------------
# Postgres backs all three. Add a Render Key Value instance and set these to
# "redis" (plus REDIS_*) when the queue gets busy enough to want it.
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Render terminates TLS, and bootstrap/app.php trusts the proxy, so Laravel
# knows the request was secure and will set this cookie flag correctly.
SESSION_SECURE_COOKIE=true

# --- Which processes this container runs ------------------------------------
# On the web service: migrate on deploy, no workers (they have their own
# services). To run everything in one service instead, set RUN_QUEUE and
# RUN_SCHEDULER to true here and delete the worker services from render.yaml.
RUN_MIGRATIONS=true
RUN_QUEUE=false
RUN_SCHEDULER=false

# --- Inertia SSR ------------------------------------------------------------
# No SSR server is deployed, so pages render in the browser. Deploy the
# Dockerfile "ssr" target as a Render private service and set this to true
# with INERTIA_SSR_URL=http://<private-service>:13714 to turn it back on.
INERTIA_SSR_ENABLED=false

# --- Mail -------------------------------------------------------------------
# Password resets and clinic invitations are queued, so the queue worker has
# to be running for any mail to leave.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

# Compiled into the JS bundle at build time, so it is a Docker build argument
# on Render (Settings → Build → Docker Build Arguments), not a runtime value.
VITE_APP_NAME="${APP_NAME}"
