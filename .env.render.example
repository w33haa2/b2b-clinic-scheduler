# Template for the Render dashboard.
#
# Load it in Render: Dashboard -> your service -> Environment ->
# "Add from .env" -> paste this whole file. Render ignores the # comments.
#
# Render does NOT read this file out of the repo, and it does NOT expand
# ${...}: every value is passed through literally, so "${APP_NAME}" arrives
# as those nine characters rather than the app's name.
#
# Working copy: copy this to .env.render (gitignored) and fill in the real
# values there. When keys change, regenerate this file from it with the
# secrets blanked, so the two cannot drift apart.
#
# Two values here do nothing as runtime variables and have to be set
# elsewhere -- see the notes at the bottom: VITE_APP_NAME and DB_SSLROOTCERT.

# --- Application ------------------------------------------------------------
APP_NAME="Clinic App"
# production, not local: APP_ENV=local disables production safeguards and
# APP_DEBUG=true was publishing full stack traces, config and env to anyone
# who hit an error page.
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Used for links the server builds with no request to work from: queued
# invitation emails, patient intake links, the sitemap, and Sanctum's stateful
# domain. Must be the service's real https URL, exactly as Render shows it --
# Render appends a suffix such as "-1" when the name you picked is taken, and
# leaving that off points every emailed link at a different site.
APP_URL=https://your-service.onrender.com

# ASSET_URL is deliberately NOT set.
#
# It overrides the host for /build/assets/*. Setting it to the wrong hostname
# is what produced the black screen: the HTML asked for the CSS and JS on a
# domain that answers 404, so nothing loaded. Left unset, Laravel builds asset
# URLs from the host the browser actually used, which is right on the
# onrender.com URL, on a preview URL and on a custom domain alike.
#
# Only set it if you put the assets behind a CDN, and then set it to the CDN.
# ASSET_URL=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Logging ----------------------------------------------------------------
# stderr, so the lines land in Render's log stream. "stack"/"single" would
# write to storage/logs inside an ephemeral container, where nobody sees them.
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Database: Neon ---------------------------------------------------------
# This is what the "Database file at path [clinic] does not exist" error was:
# DB_CONNECTION was still sqlite.
DB_CONNECTION=pgsql
# The pooled host (it contains "-pooler"). Each PHP-FPM worker holds its own
# connection; the pooler is what keeps that inside Neon's limit.
DB_HOST=ep-your-endpoint-pooler.region.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=
# Neon refuses unencrypted connections (verified: sslmode=disable is rejected).
# "require" encrypts without verifying the CA. See the note on verify-full.
DB_SSLMODE=require

# --- Sessions, cache, queue -------------------------------------------------
# All three on Postgres: no Redis service to pay for or keep alive.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_LIFETIME=120
# Session payloads are encrypted at rest in the database.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# The site is https-only. bootstrap/app.php trusts Render's proxy, so Laravel
# knows the request was secure and will set the flag correctly.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Which processes the container runs -------------------------------------
# Migrations run on deploy, from the entrypoint.
RUN_MIGRATIONS=true
# You are on one service, so the queue worker and the scheduler run inside it
# under supervisord. Both are required, not optional:
#   queue     - password resets and clinic invitations are queued; without a
#               worker no mail ever leaves.
#   scheduler - clinic:schedule-daily-sessions creates upcoming days, and
#               clinic:advance-daily-session-days starts and finishes them.
#               Daily sessions stop working without it.
# Set these to false only once you give the queue and scheduler their own
# Render worker services.
RUN_QUEUE=true
RUN_SCHEDULER=true

# --- First login ------------------------------------------------------------
# Render's Shell is a paid feature, so the first super admin is created for
# you. Two things try, whichever happens first:
#
#   1. the entrypoint, on deploy, when RUN_MIGRATIONS=true
#   2. the first visit to the landing page
#
# Both only act when the email and the password are both set, and both stop as
# soon as ONE super admin exists, so these are safe to leave in place and
# cannot produce a second account.
#
# Two things that make this look broken when it is not:
#
#   - It will NOT replace a super admin that already exists. The log names the
#     account it kept and the one it skipped.
#   - The password must satisfy the production policy from AppServiceProvider:
#     at least 12 characters, mixed case, a number, a symbol, and not present
#     in a known breach. A password that fails is reported in the log and no
#     account is created.
#
# Change the password from Settings -> Security after your first sign-in, then
# delete these three variables.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=

# --- Inertia SSR ------------------------------------------------------------
# No SSR service is deployed, so pages render in the browser. Leaving this on
# would make Laravel attempt a connection to a server that is not there on
# every first page load. The landing page's SEO tags are unaffected: they come
# from PublicSiteController, not from SSR.
INERTIA_SSR_ENABLED=false

# --- Mail (Gmail SMTP) ------------------------------------------------------
# Password resets and clinic invitations are the only mail this app sends, and
# both go through the queue, so RUN_QUEUE must stay true or they are never
# delivered. MAIL_MAILER=log silently writes them to the log instead of
# sending: it is the default, and it looks exactly like success from the UI.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com

# Port 465 with the "smtps" scheme is TLS from the first byte. Port 587 is
# plaintext that upgrades with STARTTLS, which can in principle be stripped,
# so 465 is the better default for mail that carries password-reset links.
#
# Only "smtp" and "smtps" are accepted. MAIL_SCHEME=tls or =ssl throws
# UnsupportedSchemeException, and because sending is queued, that surfaces as
# a row in failed_jobs rather than as an error anyone sees. If 465 is blocked,
# the working alternative is MAIL_PORT=587 with MAIL_SCHEME=smtp -- do not mix
# 587 with smtps, which forces implicit TLS on a port that does not speak it.
MAIL_PORT=465
MAIL_SCHEME=smtps

# The full Gmail address, and an App Password -- NOT the account password.
# App Passwords are 16 characters, require 2-Step Verification to be on, and
# are created at https://myaccount.google.com/apppasswords
# Spaces in the App Password are display only; paste it without them.
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=

# Gmail rewrites From to the authenticated account unless this exactly matches
# MAIL_USERNAME or an alias verified under Gmail Settings -> Accounts ->
# "Send mail as". Anything else is silently replaced, so keep them identical
# unless you have set an alias up.
MAIL_FROM_ADDRESS=you@gmail.com

# Written out, not "${APP_NAME}": Render passes values through literally, and
# ${...} is only expanded when phpdotenv parses a .env file. Your current
# setting sends mail from the literal string "${APP_NAME}".
MAIL_FROM_NAME="Clinic App"

# Gmail caps sending at roughly 500 recipients a day on a free account and
# 2,000 on Workspace. Fine for invitations and resets; if this app ever sends
# anything bulk, move to a transactional provider instead.

# --- Not runtime variables --------------------------------------------------
#
# VITE_APP_NAME is compiled into the JavaScript bundle at build time, so it
# has to be a Docker build argument, not an environment variable:
#   Render -> Settings -> Build -> Docker Build Arguments
#   VITE_APP_NAME = Clinic App
# (And write the value out; "${APP_NAME}" would be baked in literally.)
#
# DB_SSLMODE=verify-full additionally checks Neon's certificate chain, which
# needs a CA bundle in the image and DB_SSLROOTCERT pointing at it. "require"
# encrypts the connection but does not verify the certificate.
#
# --- Dropped from your previous configuration -------------------------------
# AWS_*            nothing uses S3 (FILESYSTEM_DISK=local)
# MEMCACHED_HOST   not used
# REDIS_*          not used while sessions/cache/queue are on the database
# APP_FAKER_LOCALE only read by Faker, a dev dependency absent in production
# LOG_STACK        only read by the "stack" channel, which is no longer used
