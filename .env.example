APP_NAME="Clinic App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail SMTP, for a real deployment. Every mail this app sends is queued, so
# the queue worker needs these too, and a bad value here fails in failed_jobs
# rather than anywhere a person would see it.
#
# MAIL_SCHEME accepts only "smtp" and "smtps". "tls" and "ssl" throw
# UnsupportedSchemeException. Port 465 pairs with smtps (TLS from the first
# byte); port 587 pairs with smtp (STARTTLS). Do not mix 587 with smtps.
#
# MAIL_PASSWORD must be a 16-character Google App Password, not the account
# password, and MAIL_FROM_ADDRESS must match MAIL_USERNAME or a verified
# "Send mail as" alias, or Gmail silently rewrites it. See docs/docker.md.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_TIMEOUT=15
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your16charapppassword
# MAIL_FROM_ADDRESS="you@gmail.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Docker (compose.yaml)
# To run the app in Docker, uncomment this block. Later keys override the
# matching ones above. See docs/docker.md.
# -----------------------------------------------------------------------------
# APP_URL=http://localhost
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=clinic
# DB_USERNAME=clinic
# DB_PASSWORD=secret
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=redis
# MAIL_MAILER=smtp
# MAIL_HOST=mailpit
# MAIL_PORT=1025

# Host ports used by compose.yaml. Change them if they clash with other services.
# APP_PORT=80
# VITE_PORT=5173
# FORWARD_DB_PORT=3306
# FORWARD_REDIS_PORT=6379
# FORWARD_MAILPIT_PORT=1025
# FORWARD_MAILPIT_DASHBOARD_PORT=8025
